                  "pm.test('BLOCKED', () => pm.expect(pm.response.json().status).to.eql('BLOCKED'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Block card again (idempotent)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{cardUrl}}/api/v1/cards/{{cardId}}/block",
              "host": [
                "{{cardUrl}}"
