    {
      "name": "3. Status transitions",
      "description": "Rode depois da pasta 1. Pedido para o status atual responde 200 sem mudança; a partir de CANCELED, block e unblock respondem 409.",
      "item": [
        {
          "name": "Block card",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{cardUrl}}/api/v1/cards/{{cardId}}/block",
              "host": [
